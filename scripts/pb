#!/usr/bin/env python3
"""pb: command-line client for pastebin-worker."""

from __future__ import annotations

import argparse
import base64
import json
import logging
import math
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Callable, Optional
from urllib.parse import unquote, urlsplit, urlunsplit

import requests

DEFAULT_DOMAIN = "https://shz.al"
SCRIPT_NAME = "pb"
MPU_THRESHOLD = 5 * 1024 * 1024  # switch to multipart upload above this size
MPU_CHUNK_SIZE = 5 * 1024 * 1024  # R2 requires every part except the last to be >=5 MiB
ENCRYPTION_SCHEME = "AES-GCM"
ENCRYPTION_HEADER = "X-PB-Encryption-Scheme"

LEVEL_COLORS = {
    logging.DEBUG: "90",
    logging.INFO: "0",
    logging.WARNING: "33",
    logging.ERROR: "31",
    logging.CRITICAL: "31",
}


class ColorFormatter(logging.Formatter):
    def __init__(self, use_color: bool) -> None:
        super().__init__(fmt="%(name)s: %(message)s")
        self.use_color = use_color

    def format(self, record: logging.LogRecord) -> str:
        msg = super().format(record)
        if not self.use_color:
            return msg
        code = LEVEL_COLORS.get(record.levelno, "0")
        return f"\x1b[0;{code}m{msg}\x1b[0m"


logger = logging.getLogger(SCRIPT_NAME)


def _format_size(n: int) -> str:
    if n >= 1024 * 1024:
        return f"{n / 1024 / 1024:.1f} MiB"
    if n >= 1024:
        return f"{n / 1024:.1f} KiB"
    return f"{n} B"


class ProgressBar:
    """Single-line progress bar rendered to stderr; no-op when stderr isn't a TTY."""

    def __init__(self, total: int, label: str = "upload") -> None:
        self.total = total
        self.done = 0
        self.label = label
        # Suppress the bar when verbose logging is on: its per-part debug lines
        # already trace progress and the \r-redraw would otherwise interleave.
        self.tty = sys.stderr.isatty() and not logger.isEnabledFor(logging.DEBUG)
        self.last_render = 0.0
        self.width = 30

    def update(self, delta: int) -> None:
        self.done = min(self.done + delta, self.total)
        self._render(force=self.done >= self.total)

    def _render(self, force: bool = False) -> None:
        if not self.tty:
            return
        now = time.monotonic()
        if not force and now - self.last_render < 0.1:
            return
        self.last_render = now
        frac = self.done / self.total if self.total > 0 else 1.0
        filled = int(self.width * frac)
        if filled >= self.width:
            bar = "=" * self.width
        else:
            bar = "=" * filled + ">" + " " * (self.width - filled - 1)
        msg = (
            f"\r{self.label} [{bar}] {_format_size(self.done)} / "
            f"{_format_size(self.total)} ({frac * 100:.0f}%)"
        )
        sys.stderr.write(msg)
        sys.stderr.flush()

    def close(self) -> None:
        if self.tty:
            sys.stderr.write("\n")
            sys.stderr.flush()


class ProgressReader:
    """File-like wrapper over a bytes buffer; calls on_read(n) as bytes are consumed.

    requests streams from `data=<file-like>` by calling .read(size) repeatedly,
    so we get fine-grained progress within a single PUT/POST.
    """

    def __init__(self, buf: bytes, on_read: Callable[[int], None]) -> None:
        self.buf = buf
        self.pos = 0
        self.on_read = on_read

    def __len__(self) -> int:
        return len(self.buf)

    def read(self, size: int = -1) -> bytes:
        if size is None or size < 0:
            size = len(self.buf) - self.pos
        chunk = self.buf[self.pos : self.pos + size]
        self.pos += len(chunk)
        if chunk:
            self.on_read(len(chunk))
        return chunk


def _import_aesgcm():
    # Lazy import so that users who only upload with -u/--unencrypted and fetch
    # plain pastes don't need the 'cryptography' dependency installed.
    try:
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    except ImportError:
        die(
            "encryption requires the 'cryptography' package; "
            "install it with `pip install cryptography`, "
            "or pass -u/--unencrypted to upload without encryption"
        )
        raise  # unreachable; appeases type-checker
    return AESGCM


def b64_variant_encode(data: bytes) -> str:
    # Same variant as the frontend: '/' -> '_', strip trailing '='. '+' is kept.
    return base64.b64encode(data).decode("ascii").replace("/", "_").rstrip("=")


def b64_variant_decode(s: str) -> bytes:
    s = s.replace("_", "/")
    pad = (-len(s)) % 4
    return base64.b64decode(s + "=" * pad)


def encrypt_body(body: bytes) -> tuple[str, bytes]:
    AESGCM = _import_aesgcm()
    raw_key = os.urandom(32)
    iv = os.urandom(12)
    ciphertext = AESGCM(raw_key).encrypt(iv, body, None)
    return b64_variant_encode(raw_key), iv + ciphertext


def decrypt_body(scheme: str, encoded_key: str, blob: bytes) -> bytes:
    if scheme != ENCRYPTION_SCHEME:
        die(f"unsupported encryption scheme: {scheme}")
    AESGCM = _import_aesgcm()
    try:
        raw_key = b64_variant_decode(encoded_key)
    except (ValueError, base64.binascii.Error) as e:
        die(f"invalid decryption key: {e}")
        raise
    if len(raw_key) not in (16, 24, 32):
        die(
            f"AES-GCM key must decode to 16/24/32 bytes, got {len(raw_key)}; "
            "make sure the full URL fragment was passed"
        )
    if len(blob) < 12 + 16:
        die("ciphertext too short to contain IV + GCM tag")
    iv, ct = blob[:12], blob[12:]
    from cryptography.exceptions import InvalidTag

    try:
        return AESGCM(raw_key).decrypt(iv, ct, None)
    except InvalidTag:
        die("decryption failed: wrong key or corrupted ciphertext")
        raise


def make_decryption_url(paste_url: str, encoded_key: str) -> str:
    parts = urlsplit(paste_url)
    return urlunsplit((parts.scheme, parts.netloc, "/d" + parts.path, "", encoded_key))


def bare_paste_name(name: str) -> str:
    # /get accepts NAME[.EXT] or NAME/FILENAME; the history is keyed on the
    # bare name. Paste names never contain "." or "/".
    return name.split("/", 1)[0].split(".", 1)[0]


def parse_paste_url(arg: str) -> Optional[tuple]:
    """Split a paste URL such as https://shz.al/d/abcd#KEY into its endpoint, the
    path after any role prefix ("abcd", "abcd.md", "abcd:PASSWD", ...) and the
    key in the fragment, which may be None. Returns None if `arg` is not a URL."""
    if not re.match(r"https?://", arg):
        return None
    parts = urlsplit(arg)
    path = unquote(parts.path).lstrip("/")
    # a one-letter role such as d/, a/, u/ or m/, as the worker parses it
    if len(path) > 1 and path[1] == "/":
        path = path[2:]
    if not bare_paste_name(path):
        die(f"no paste name in URL '{arg}'")
    # markdown URLs may append ":<section>" to the key
    key = parts.fragment.split(":", 1)[0] or None
    return urlunsplit((parts.scheme, parts.netloc, "", "", "")), path, key


def _confirm_overwrite(path: Path) -> bool:
    # Non-interactive callers must opt in explicitly via -f/--force; we refuse
    # rather than silently overwriting or silently skipping so scripts get a
    # clear signal.
    if not sys.stdin.isatty():
        die(
            f"refusing to overwrite '{path}' in non-interactive mode; "
            "pass -f/--force to overwrite"
        )
    try:
        ans = input(f"file '{path}' exists, overwrite? [y/N] ").strip().lower()
    except EOFError:
        return False
    return ans in ("y", "yes")


def parse_content_disposition_filename(header: Optional[str]) -> Optional[str]:
    # Worker always emits the RFC-5987 form: `filename*=UTF-8''<urlencoded>`.
    # Accept the legacy `filename="..."` too, in case that ever changes.
    if not header:
        return None
    m = re.search(r"filename\*=([^']*)'([^']*)'([^;]+)", header)
    if m:
        charset, _lang, value = m.groups()
        try:
            return unquote(value, encoding=charset or "utf-8")
        except (LookupError, UnicodeDecodeError):
            return unquote(value)
    m = re.search(r'filename="([^"]+)"', header) or re.search(
        r"filename=([^;\s]+)", header
    )
    return m.group(1) if m else None


def setup_logger(verbose: bool) -> None:
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(ColorFormatter(use_color=sys.stderr.isatty()))
    logger.handlers.clear()
    logger.addHandler(handler)
    logger.setLevel(logging.DEBUG if verbose else logging.INFO)


def die(msg: str) -> "Optional[None]":
    logger.error(msg)
    sys.exit(1)


# ---------------------------------------------------------------------------
# History
#
# Every successful post, update and delete appends one JSON line to the
# history file, so later commands can find a paste's password and key by its
# name. A record looks like
#
#   {"v": 1, "op": "post", "ts": "2026-10-23T08:00:00Z",
#    "base": "https://shz.al", "name": "abcd", "passwd": "...", "key": "...",
#    "url": "https://shz.al/abcd", "filename": "a.md", "size": 1234,
#    "expireAt": "2026-10-30T08:00:00Z"}
#
# The state of a paste is the fold of its records, keyed by endpoint and
# name: an update replaces the password and key ("key": null means the paste
# is no longer encrypted), and a delete marks it deleted. Appending keeps
# concurrent pb runs from overwriting each other, and a damaged line only
# loses that record.

HISTORY_VERSION = 1
HISTORY_OPS = ("post", "update", "delete")


def history_path() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(base) / "pb" / "history.jsonl"


def legacy_history_path() -> Path:
    # Where pb used to keep its history, in the "NAME:PASSWD[#KEY]" format.
    # It read the non-standard XDG_CONFIG_DIR rather than XDG_CONFIG_HOME.
    base = os.environ.get("XDG_CONFIG_DIR") or os.path.expanduser("~/.config")
    return Path(base) / "pb_hist"


def normalize_base(domain: str) -> str:
    parts = urlsplit(domain)
    return urlunsplit(
        (parts.scheme.lower(), parts.netloc.lower(), parts.path.rstrip("/"), "", "")
    )


def _now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _parse_iso(ts: Optional[str]) -> Optional[datetime]:
    if not ts:
        return None
    try:
        # fromisoformat() only accepts a trailing "Z" from Python 3.11 on
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None


def _write_history(lines: list, mode: str) -> None:
    p = history_path()
    try:
        # the file holds passwords and keys: keep it private to the user
        p.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if mode == "a":
            fd = os.open(p, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a") as f:
                f.write("".join(lines))
        else:
            # rewrite atomically, so an interrupted prune keeps the old file
            tmp = p.with_name(p.name + ".tmp")
            fd = os.open(tmp, os.O_WRONLY | os.O_TRUNC | os.O_CREAT, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write("".join(lines))
            os.replace(tmp, p)
    except OSError as e:
        die(f"cannot write history file '{p}': {e}")


def append_history(record: dict) -> None:
    line = json.dumps(
        {"v": HISTORY_VERSION, "ts": _now_iso(), **record}, ensure_ascii=False
    )
    _write_history([line + "\n"], "a")


def read_history() -> list:
    p = history_path()
    if not p.exists():
        return []
    records = []
    try:
        with p.open() as f:
            for lineno, line in enumerate(f, 1):
                if not line.strip():
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    logger.debug(f"{p}:{lineno}: not JSON, skipped")
                    continue
                if (
                    not isinstance(rec, dict)
                    or rec.get("v") != HISTORY_VERSION
                    or rec.get("op") not in HISTORY_OPS
                    or not isinstance(rec.get("base"), str)
                    or not isinstance(rec.get("name"), str)
                ):
                    logger.debug(f"{p}:{lineno}: not a history record, skipped")
                    continue
                records.append(rec)
    except OSError as e:
        die(f"cannot read history file '{p}': {e}")
    return records


class Paste:
    """The current state of one paste, folded from its history records."""

    def __init__(self, base: str, name: str) -> None:
        self.base = base
        self.name = name
        self.passwd: Optional[str] = None
        self.key: Optional[str] = None
        self.url: Optional[str] = None
        self.filename: Optional[str] = None
        self.size: Optional[int] = None
        self.expire_at: Optional[str] = None
        self.created: Optional[str] = None
        self.updated: Optional[str] = None
        self.deleted = False
        self.imported = False

    def apply(self, rec: dict) -> None:
        if rec["op"] == "delete":
            self.deleted = True
            self.updated = rec.get("ts")
            return
        if rec["op"] == "post" or self.deleted:
            self.__init__(self.base, self.name)  # a new paste under the same name
            self.created = rec.get("ts")
        self.passwd = rec.get("passwd")
        self.key = rec.get("key")
        self.imported = bool(rec.get("imported"))
        if self.imported:
            # the old history did not record when a paste was uploaded
            self.created = None
        for attr, field in (
            ("url", "url"),
            ("filename", "filename"),
            ("size", "size"),
            ("expire_at", "expireAt"),
        ):
            if rec.get(field) is not None:
                setattr(self, attr, rec[field])
        self.updated = None if self.imported else rec.get("ts")

    def is_expired(self, now: datetime) -> bool:
        expire_at = _parse_iso(self.expire_at)
        return expire_at is not None and expire_at <= now

    def is_live(self, now: datetime) -> bool:
        return not self.deleted and not self.is_expired(now)

    def share_url(self) -> Optional[str]:
        if self.url and self.key:
            return make_decryption_url(self.url, self.key)
        return self.url

    def to_json(self) -> dict:
        return {
            "base": self.base,
            "name": self.name,
            "url": self.share_url(),
            "manageUrl": f"{self.base}/{self.name}:{self.passwd}"
            if self.passwd
            else None,
            "filename": self.filename,
            "size": self.size,
            "encrypted": self.key is not None,
            "createdAt": self.created,
            "updatedAt": self.updated,
            "expireAt": self.expire_at,
            "deleted": self.deleted,
            "imported": self.imported,
        }


def history_state(records: Optional[list] = None) -> dict:
    """Map (base, name) to Paste, in the order the pastes were last touched."""
    state: dict = {}
    for rec in read_history() if records is None else records:
        k = (rec["base"], rec["name"])
        paste = state.pop(k, None) or Paste(*k)
        paste.apply(rec)
        state[k] = paste
    return state


def lookup_paste(domain: str, name: str) -> Optional[Paste]:
    """The paste called `name` on `domain` that is not deleted. Custom names are
    recorded with their leading '~', which may be left out."""
    state = history_state()
    base = normalize_base(domain)
    candidates = [name] if name.startswith("~") else [name, f"~{name}"]
    for candidate in candidates:
        paste = state.get((base, candidate))
        if paste is not None and not paste.deleted:
            return paste
    return None


def resolve_name(domain: str, name: str) -> str:
    """The recorded name of a paste, which adds the '~' of a custom name"""
    paste = lookup_paste(domain, name)
    return paste.name if paste else name


def _migrate_hint() -> str:
    legacy = legacy_history_path()
    if legacy.exists():
        return f"; to use the old history file '{legacy}', run 'pb history migrate'"
    return ""


def lookup_passwd(domain: str, name: str) -> Optional[str]:
    paste = lookup_paste(domain, name)
    return paste.passwd if paste else None


def lookup_key(domain: str, name: str) -> Optional[str]:
    paste = lookup_paste(domain, name)
    return paste.key if paste else None


# Legacy lines are "NAME:PASSWD" or "NAME:PASSWD#KEY". PASSWD only forbids
# newlines, so it may contain '#'. KEYs are b64-variant-encoded raw AES keys,
# always [A-Za-z0-9+_]{22,32,43} (no padding, for 128/192/256-bit); that exact
# shape tells a key suffix apart from a '#' in the password.
_KEY_SUFFIX_RE = re.compile(r"#([A-Za-z0-9+_]+)$")


def _split_passwd_and_key(value: str) -> tuple:
    m = _KEY_SUFFIX_RE.search(value)
    if m and len(m.group(1)) in (22, 32, 43):
        return value[: m.start()], m.group(1)
    return value, None


def clip(text: str) -> None:
    candidates = [
        ("pbcopy", []),
        ("xclip", ["-selection", "clipboard"]),
        ("xsel", ["-b"]),
        ("wl-copy", []),
    ]
    for cmd, args in candidates:
        if shutil.which(cmd):
            try:
                subprocess.run([cmd, *args], input=text.encode(), check=True)
                logger.info(f"'{text}' is copied to your clipboard")
            except subprocess.CalledProcessError as e:
                logger.warning(f"clipboard command '{cmd}' failed: {e}")
            return
    logger.warning(
        "Cannot find a clipboard tool. Requires one of "
        "'pbcopy' (macOS), 'xclip' (xorg), 'xsel' (xorg) or 'wl-copy' (wayland)."
    )


def read_content(file: Optional[str], content: Optional[str]) -> bytes:
    if content is not None and file is not None:
        die("cannot set both 'content' and 'file'")
    if file is not None:
        try:
            return Path(file).read_bytes()
        except OSError as e:
            die(f"cannot read file '{file}': {e}")
    if content is not None:
        return content.encode()
    return sys.stdin.buffer.read()


def log_request(method: str, url: str, fields: dict, params: dict) -> None:
    masked = {k: ("***" if k == "s" else v) for k, v in fields.items()}
    logger.debug(f"{method} {url}  fields={masked}  params={params}")


def manage_basename(manage_url: str) -> str:
    return manage_url.rstrip("/").rsplit("/", 1)[-1]


def _print_json(payload: dict) -> None:
    """Pretty-print JSON. If `jq` is on PATH, hand off to it for syntax coloring
    (matching what the old Bash script did); otherwise use stdlib indentation.
    `jq -C` forces color even when its stdout is not a TTY, so we gate on the
    real TTY here."""
    raw = json.dumps(payload, ensure_ascii=False)
    if shutil.which("jq"):
        color_flag = "-C" if sys.stdout.isatty() else "-M"
        try:
            subprocess.run(["jq", color_flag, "."], input=raw.encode(), check=True)
            return
        except (subprocess.CalledProcessError, OSError) as e:
            logger.debug(f"jq failed, falling back to plain JSON: {e}")
    print(json.dumps(payload, indent=2, ensure_ascii=False))


def _finalize_response(
    payload: dict,
    clip_flag: bool,
    history: dict,
    encryption_key: Optional[str] = None,
) -> None:
    """Print the server's response and record it in the history. `history`
    holds the record fields the response lacks: op, base and filename."""
    page_url = payload.get("url")
    display_url: Optional[str] = None
    if encryption_key and page_url:
        display_url = make_decryption_url(page_url, encryption_key)
        # The server response does not include the key (client-side only),
        # so surface it in the printed JSON for easy scripting.
        payload["decryptionUrl"] = display_url
    _print_json(payload)
    manage_url = payload.get("manageUrl")
    if manage_url:
        name, _, passwd = manage_basename(manage_url).partition(":")
        append_history(
            {
                **history,
                "name": name,
                "passwd": passwd,
                "key": encryption_key,
                "url": page_url,
                "size": payload.get("sizeBytes"),
                "expireAt": payload.get("expireAt"),
            }
        )
    if clip_flag:
        target = display_url or page_url
        if target:
            clip(target)


def upload_mpu(
    domain: str,
    body: bytes,
    fields: dict,
    is_update: bool,
    name: Optional[str],
    passwd: Optional[str],
    is_private: bool,
    expire: Optional[str],
    dry: bool,
    clip_flag: bool,
    history: dict,
    encryption_key: Optional[str] = None,
    filename: Optional[str] = None,
) -> None:
    """Multipart upload for files larger than MPU_THRESHOLD.

    For post:   POST /mpu/create?n=&p=&e=
    For update: POST /mpu/create-update?name=&password=&e=
    Then PUT /mpu/resume?key=&uploadId=&partNumber= for each 5 MiB chunk.
    Finally POST /mpu/complete?name=&key=&uploadId= with `c=<json parts list>`.
    """
    total = len(body)
    num_parts = max(1, math.ceil(total / MPU_CHUNK_SIZE))

    if is_update:
        create_url = f"{domain}/mpu/create-update"
        create_params: dict = {"name": name, "password": passwd}
    else:
        create_url = f"{domain}/mpu/create"
        create_params = {}
        if name:
            create_params["n"] = name.lstrip("~")
        if is_private:
            create_params["p"] = "1"
    if expire:
        create_params["e"] = expire

    masked_create_params = dict(create_params)
    if "password" in masked_create_params:
        masked_create_params["password"] = "***"
    log_request("POST", create_url, {}, masked_create_params)
    logger.info(
        f"using MPU: {_format_size(total)} in {num_parts} part(s) of "
        f"{_format_size(MPU_CHUNK_SIZE)}"
    )
    if dry:
        for i in range(num_parts):
            chunk_size = min(MPU_CHUNK_SIZE, total - i * MPU_CHUNK_SIZE)
            log_request(
                "PUT",
                f"{domain}/mpu/resume",
                {},
                {"partNumber": i + 1, "size": chunk_size},
            )
        log_request("POST", f"{domain}/mpu/complete", {**fields, "c": "<parts...>"}, {})
        return

    try:
        create_resp = requests.post(create_url, params=create_params)
    except requests.RequestException as e:
        die(f"MPU create failed: {e}")
        return
    if not create_resp.ok:
        die(f"MPU create {create_resp.status_code}: {create_resp.text}")
    create = create_resp.json()
    key = create["key"]
    upload_id = create["uploadId"]
    paste_name = create["name"]

    bar = ProgressBar(total, label="MPU")
    uploaded_parts: list = []
    completed = False
    try:
        for i in range(num_parts):
            chunk = body[i * MPU_CHUNK_SIZE : (i + 1) * MPU_CHUNK_SIZE]
            logger.debug(f"PUT part {i + 1}/{num_parts}  size={len(chunk)}")
            reader = ProgressReader(chunk, bar.update)
            try:
                part_resp = requests.put(
                    f"{domain}/mpu/resume",
                    params={
                        "key": key,
                        "uploadId": upload_id,
                        "partNumber": i + 1,
                    },
                    data=reader,
                    headers={"Content-Length": str(len(chunk))},
                )
            except requests.RequestException as e:
                die(f"MPU part {i + 1} failed: {e}")
                return
            if not part_resp.ok:
                die(f"MPU part {i + 1} {part_resp.status_code}: {part_resp.text}")
            uploaded_parts.append(part_resp.json())

        complete_params = {"name": paste_name, "key": key, "uploadId": upload_id}
        complete_data = dict(fields)
        log_request(
            "POST" if not is_update else "PUT",
            f"{domain}/mpu/complete",
            {**complete_data, "c": "<parts...>"},
            complete_params,
        )
        try:
            complete_resp = requests.request(
                "POST" if not is_update else "PUT",
                f"{domain}/mpu/complete",
                params=complete_params,
                data=complete_data,
                files={"c": (filename, json.dumps(uploaded_parts).encode())},
            )
        except requests.RequestException as e:
            die(f"MPU complete failed: {e}")
            return
        if not complete_resp.ok:
            die(f"MPU complete {complete_resp.status_code}: {complete_resp.text}")

        try:
            payload = complete_resp.json()
        except ValueError:
            die(f"non-JSON response from /mpu/complete: {complete_resp.text}")
            return
        completed = True
    finally:
        bar.close()
        # Release R2-side multipart state if we didn't reach complete (chunk failed,
        # complete failed, Ctrl-C, etc.). Knowing key+uploadId is the auth.
        if not completed:
            try:
                requests.post(
                    f"{domain}/mpu/abort",
                    params={"key": key, "uploadId": upload_id},
                    timeout=5,
                )
                logger.info("MPU aborted on server")
            except requests.RequestException as abort_err:
                logger.warning(
                    f"MPU abort failed; orphaned parts may remain: {abort_err}"
                )

    _finalize_response(payload, clip_flag, history, encryption_key=encryption_key)


def post_or_put(
    method: str,
    url: str,
    fields: dict,
    body: Optional[bytes],
    verbose: bool,
    dry: bool,
    clip_flag: bool,
    history: dict,
    log_url: Optional[str] = None,
    encryption_key: Optional[str] = None,
    filename: Optional[str] = None,
) -> None:
    files: dict = {}
    data: dict = {}
    for k, v in fields.items():
        data[k] = v
    if body is not None:
        # When no filename is provided, pass None so requests omits the
        # `filename=` parameter entirely; the worker then stores no filename
        # and clients can fall back to the paste name on download.
        files["c"] = (filename, body)

    log_request(
        method,
        log_url or url,
        {**fields, "c": "<...>" if body is not None else None},
        {},
    )
    if dry:
        return

    try:
        resp = requests.request(method, url, data=data, files=files or None)
    except requests.RequestException as e:
        die(f"request failed: {e}")
        return  # for type-checker; die() exits

    if resp.status_code not in (200, 302):
        die(f"{resp.status_code}: {resp.text}")

    try:
        payload = resp.json()
    except ValueError:
        die(f"non-JSON response: {resp.text}")
        return

    _finalize_response(payload, clip_flag, history, encryption_key=encryption_key)


def parse_name_passwd(arg: str) -> tuple[str, Optional[str]]:
    if ":" in arg:
        name, passwd = arg.split(":", 1)
        return name, passwd
    return arg, None


def cmd_post(args: argparse.Namespace, domain: str) -> None:
    if args.private and args.name:
        die("cannot set both 'private' and 'name'")
    if args.file and args.file_pos:
        die("cannot specify FILE both as positional argument and via '-f'")

    file = args.file or args.file_pos
    body = read_content(file, args.content)
    filename = args.filename or (Path(file).name if file else None)

    encryption_key: Optional[str] = None
    if args.encrypt:
        encryption_key, body = encrypt_body(body)
    history = {"op": "post", "base": normalize_base(domain), "filename": filename}

    if len(body) > MPU_THRESHOLD:
        mpu_fields: dict = {}
        if args.expire:
            mpu_fields["e"] = args.expire
        if args.passwd:
            mpu_fields["s"] = args.passwd
        if args.encrypt:
            mpu_fields["encryption-scheme"] = ENCRYPTION_SCHEME
        upload_mpu(
            domain,
            body,
            mpu_fields,
            is_update=False,
            name=args.name,
            passwd=None,
            is_private=bool(args.private),
            expire=args.expire,
            dry=args.dry,
            clip_flag=args.clip,
            history=history,
            encryption_key=encryption_key,
            filename=filename,
        )
        return

    fields: dict = {}
    if args.expire:
        fields["e"] = args.expire
    if args.name:
        fields["n"] = args.name
    if args.passwd:
        fields["s"] = args.passwd
    if args.private:
        fields["p"] = "true"
    if args.encrypt:
        fields["encryption-scheme"] = ENCRYPTION_SCHEME

    post_or_put(
        "POST",
        f"{domain}/",
        fields,
        body,
        args.verbose,
        args.dry,
        args.clip,
        history=history,
        encryption_key=encryption_key,
        filename=filename,
    )


def cmd_update(args: argparse.Namespace, domain: str) -> None:
    url = parse_paste_url(args.target)
    if url:
        domain, args.target, _ = url
    name, passwd = parse_name_passwd(args.target)
    name = resolve_name(domain, name)
    if passwd is None:
        passwd = args.passwd or lookup_passwd(domain, name)
    if not passwd:
        die(
            f"no passwd given, and cannot find it in the history file '{history_path()}'"
            + _migrate_hint()
        )

    body = read_content(args.file, args.content)
    filename = args.filename or (Path(args.file).name if args.file else None)

    encryption_key: Optional[str] = None
    if args.encrypt:
        encryption_key, body = encrypt_body(body)
    history = {"op": "update", "base": normalize_base(domain), "filename": filename}

    if len(body) > MPU_THRESHOLD:
        mpu_fields: dict = {}
        if args.expire:
            mpu_fields["e"] = args.expire
        if args.passwd:
            mpu_fields["s"] = args.passwd
        if args.encrypt:
            mpu_fields["encryption-scheme"] = ENCRYPTION_SCHEME
        upload_mpu(
            domain,
            body,
            mpu_fields,
            is_update=True,
            name=name,
            passwd=passwd,
            is_private=False,
            expire=args.expire,
            dry=args.dry,
            clip_flag=args.clip,
            history=history,
            encryption_key=encryption_key,
            filename=filename,
        )
        return

    fields: dict = {}
    if args.expire:
        fields["e"] = args.expire
    if args.passwd:
        fields["s"] = args.passwd
    if args.encrypt:
        fields["encryption-scheme"] = ENCRYPTION_SCHEME

    post_or_put(
        "PUT",
        f"{domain}/{name}:{passwd}",
        fields,
        body,
        args.verbose,
        args.dry,
        args.clip,
        history=history,
        log_url=f"{domain}/{name}:***",
        encryption_key=encryption_key,
        filename=filename,
    )


def cmd_get(args: argparse.Namespace, domain: str) -> None:
    url_key: Optional[str] = None
    url = parse_paste_url(args.name)
    if url:
        domain, path, url_key = url
        # a manage URL works too; reading needs no password
        args.name = path.split(":", 1)[0]
    if args.meta:
        if args.url:
            die("cannot combine --meta with --url")
        prefix = "m"
    elif args.url:
        prefix = "u"
    else:
        prefix = None
    if args.save is not None and args.output:
        die("cannot combine --save with -o/--output")
    bare = bare_paste_name(args.name)
    args.name = resolve_name(domain, bare) + args.name[len(bare) :]
    base = f"{domain}/{prefix}/{args.name}" if prefix else f"{domain}/{args.name}"

    log_request("GET", base, {}, {})
    if args.dry:
        return

    try:
        resp = requests.get(base, allow_redirects=False)
    except requests.RequestException as e:
        die(f"request failed: {e}")
        return

    if resp.status_code not in (200, 302):
        die(f"{resp.status_code}: {resp.text}")

    if args.meta:
        try:
            payload = resp.json()
        except ValueError:
            die(f"non-JSON response from /m/: {resp.text}")
            return
        _print_json(payload)
        return

    content = resp.content
    scheme = resp.headers.get(ENCRYPTION_HEADER)
    decrypted = False
    if scheme and not args.no_decrypt:
        key = args.key or url_key or lookup_key(domain, bare_paste_name(args.name))
        if not key:
            die(
                f"paste '{args.name}' is encrypted ({scheme}); pass --key KEY "
                f"or use --no-decrypt to keep the raw ciphertext" + _migrate_hint()
            )
        content = decrypt_body(scheme, key, content)
        decrypted = True
    elif args.key and not scheme:
        logger.warning("--key given but paste is not encrypted; ignoring")

    if args.save is not None:
        server_name = parse_content_disposition_filename(
            resp.headers.get("Content-Disposition")
        )
        # Server tags encrypted downloads with a trailing `.encrypted`; strip
        # it once we've actually decrypted so the saved file gets its real name.
        if decrypted and server_name and server_name.endswith(".encrypted"):
            server_name = server_name[: -len(".encrypted")]
        # Defend against absolute paths / traversal in the server-supplied name.
        if server_name:
            server_name = Path(server_name).name
        filename = server_name or bare_paste_name(args.name)
        base_dir = Path(args.save)
        try:
            base_dir.mkdir(parents=True, exist_ok=True)
        except OSError as e:
            die(f"cannot create save dir '{base_dir}': {e}")
        out_path = base_dir / filename
        if out_path.exists() and not args.force:
            if not _confirm_overwrite(out_path):
                logger.info("aborted; file not overwritten")
                return
        out_path.write_bytes(content)
        logger.info(f"saved to '{out_path}'")
        return

    if args.output:
        Path(args.output).write_bytes(content)
    else:
        # Mirror curl's behaviour: refuse to splat binary at a terminal,
        # because escape sequences in the content can wedge the user's tty.
        # A NUL byte is the simplest reliable binary signal and matches what
        # file(1) and most tools use.
        if sys.stdout.isatty() and b"\x00" in content and not args.force:
            die(
                "refusing to write binary output to a terminal. "
                "Use -o FILE to save, --save [DIR] to use the server filename, "
                "pipe the output, or pass -f/--force to write anyway"
            )
        sys.stdout.buffer.write(content)


def cmd_delete(args: argparse.Namespace, domain: str) -> None:
    url = parse_paste_url(args.target)
    if url:
        domain, args.target, _ = url
    name, passwd = parse_name_passwd(args.target)
    name = resolve_name(domain, name)
    if passwd is None:
        passwd = lookup_passwd(domain, name)
    if not passwd:
        die(
            f"no passwd given, and cannot find it in the history file '{history_path()}'"
            + _migrate_hint()
        )

    url = f"{domain}/{name}:{passwd}"
    log_request("DELETE", f"{domain}/{name}:***", {}, {})
    if args.dry:
        return

    try:
        resp = requests.delete(url)
    except requests.RequestException as e:
        die(f"request failed: {e}")
        return

    if resp.status_code != 200:
        die(f"{resp.status_code}: {resp.text}")
    append_history({"op": "delete", "base": normalize_base(domain), "name": name})


def _format_remaining(paste: Paste, now: datetime) -> str:
    if paste.deleted:
        return "deleted"
    expire_at = _parse_iso(paste.expire_at)
    if expire_at is None:
        return "?"
    seconds = (expire_at - now).total_seconds()
    if seconds <= 0:
        return "expired"
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{int(seconds // size)}{unit}"
    return f"{int(seconds)}s"


def _format_local_time(ts: Optional[str]) -> str:
    dt = _parse_iso(ts)
    return dt.astimezone().strftime("%Y-%m-%d %H:%M") if dt else "?"


def cmd_list(args: argparse.Namespace, domain: str) -> None:
    now = datetime.now(timezone.utc)
    base = normalize_base(domain)
    pastes = [
        p
        for p in history_state().values()
        if (args.all_endpoints or p.base == base) and (args.all or p.is_live(now))
    ]
    pastes.reverse()  # most recently touched first

    if args.names:
        for p in pastes:
            print(p.name)
        return
    if args.json:
        for p in pastes:
            print(json.dumps(p.to_json(), ensure_ascii=False))
        return
    if not pastes:
        logger.info(f"no pastes on {base} in the history file '{history_path()}'")
        return

    rows = [("NAME", "UPLOADED", "EXPIRES", "SIZE", "ENC", "FILENAME", "URL")]
    for p in pastes:
        rows.append(
            (
                p.name,
                _format_local_time(p.created or p.updated),
                _format_remaining(p, now),
                _format_size(p.size) if p.size is not None else "?",
                "yes" if p.key else "",
                p.filename or "",
                p.share_url() or "",
            )
        )
    widths = [max(len(row[i]) for row in rows) for i in range(len(rows[0]) - 1)]
    for row in rows:
        cells = [cell.ljust(width) for cell, width in zip(row, widths)]
        print("  ".join(cells + [row[-1]]).rstrip())


def cmd_history_migrate(args: argparse.Namespace, domain: str) -> None:
    src = Path(args.file) if args.file else legacy_history_path()
    try:
        lines = src.read_text().splitlines()
    except OSError as e:
        die(f"cannot read old history file '{src}': {e}")
        return

    # The old file has one line per post or update; the last one of a name
    # holds its current password and key.
    latest: dict = {}
    for line in lines:
        name, sep, value = line.partition(":")
        if not name or not sep:
            continue
        latest.pop(name, None)
        latest[name] = _split_passwd_and_key(value)

    base = normalize_base(domain)
    state = history_state()
    new = [(name, pk) for name, pk in latest.items() if (base, name) not in state]
    for name, (passwd, key) in new:
        logger.debug(f"import {name}{' (encrypted)' if key else ''}")
    if args.dry:
        logger.info(
            f"would import {len(new)} of {len(latest)} pastes from '{src}' as pastes on {base}"
        )
        return
    if new:
        _write_history(
            [
                json.dumps(
                    {
                        "v": HISTORY_VERSION,
                        "ts": _now_iso(),
                        "op": "post",
                        "base": base,
                        "name": name,
                        "passwd": passwd,
                        "key": key,
                        "url": f"{base}/{name}",
                        "imported": True,
                    },
                    ensure_ascii=False,
                )
                + "\n"
                for name, (passwd, key) in new
            ],
            "a",
        )
    skipped = len(latest) - len(new)
    logger.info(
        f"imported {len(new)} pastes from '{src}' into '{history_path()}' as pastes on {base}"
        + (f", skipped {skipped} already there" if skipped else "")
        + ". The old file is left in place; remove it once you no longer need it."
    )


def cmd_history_prune(args: argparse.Namespace, domain: str) -> None:
    now = datetime.now(timezone.utc)
    records = read_history()
    state = history_state(records)
    gone = {k for k, p in state.items() if not p.is_live(now)}
    kept = [rec for rec in records if (rec["base"], rec["name"]) not in gone]
    for base, name in gone:
        logger.debug(
            f"prune {base}/{name} ({_format_remaining(state[(base, name)], now)})"
        )
    removed = len(records) - len(kept)
    if args.dry:
        logger.info(
            f"would remove {removed} records of {len(gone)} deleted or expired pastes"
        )
        return
    if removed:
        _write_history(
            [json.dumps(rec, ensure_ascii=False) + "\n" for rec in kept], "w"
        )
    logger.info(
        f"removed {removed} records of {len(gone)} deleted or expired pastes from '{history_path()}'"
    )


def build_common_parser() -> argparse.ArgumentParser:
    """Parent parser holding flags that may appear before OR after the action.

    Using default=argparse.SUPPRESS means subparser parsing does NOT clobber
    values already set by the main parser when the same flag appears before
    the action.
    """
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        default=argparse.SUPPRESS,
        help="verbose output",
    )
    common.add_argument(
        "-d",
        "--dry",
        action="store_true",
        default=argparse.SUPPRESS,
        help="dry run, do not send the request",
    )
    common.add_argument(
        "--base-url",
        dest="base_url",
        metavar="URL",
        default=argparse.SUPPRESS,
        help=f"base URL of the pastebin instance (overrides $PB_DOMAIN, default: {DEFAULT_DOMAIN})",
    )
    return common


def add_encryption_arguments(p: argparse.ArgumentParser) -> None:
    group = p.add_mutually_exclusive_group()
    group.add_argument(
        "-u",
        "--unencrypted",
        dest="encrypt",
        action="store_false",
        help="upload without client-side encryption",
    )
    # encryption is the default; the flag is kept so older invocations still work
    group.add_argument(
        "-E",
        "--encrypt",
        dest="encrypt",
        action="store_true",
        help="client-side encrypt with a fresh AES-GCM key (the default)",
    )
    p.set_defaults(encrypt=True)


def build_parser() -> argparse.ArgumentParser:
    common = build_common_parser()
    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        description="pastebin-worker command-line client",
        parents=[common],
    )
    sub = parser.add_subparsers(dest="action", required=True, metavar="ACTION")

    p_post = sub.add_parser(
        "post",
        aliases=["p"],
        help="upload a paste",
        description="Upload a paste. If neither FILE nor -c/--content is given, "
        "the paste content is read from stdin.",
        parents=[common],
    )
    p_post.add_argument("-c", "--content", help="inline content of the paste")
    p_post.add_argument("-e", "--expire", help="expiration time (e.g. 60, 1h, 7d)")
    p_post.add_argument("-n", "--name", help="custom name (prefix with ~)")
    p_post.add_argument("-s", "--passwd", help="password")
    p_post.add_argument(
        "-p", "--private", action="store_true", help="use longer random name"
    )
    p_post.add_argument(
        "-x", "--clip", action="store_true", help="copy URL to clipboard"
    )
    add_encryption_arguments(p_post)
    p_post.add_argument(
        "-F",
        "--filename",
        help="override the filename stored with the paste "
        "(defaults to the basename of the source file, if any)",
    )
    p_post.add_argument("-f", "--file", help="read paste from file")
    p_post.add_argument(
        "file_pos", nargs="?", metavar="FILE", help="read paste from file (positional)"
    )
    p_post.set_defaults(func=cmd_post)

    p_update = sub.add_parser(
        "update",
        aliases=["u"],
        help="update an existing paste",
        description="Update an existing paste. If neither -f/--file nor -c/--content "
        "is given, the new content is read from stdin. If PASSWD is omitted, it is "
        "looked up from the history file.",
        parents=[common],
    )
    p_update.add_argument(
        "target",
        help="NAME[:PASSWD], or a URL of the paste such as its manage URL, "
        "which also selects the endpoint",
    )
    p_update.add_argument("-c", "--content", help="inline content of the paste")
    p_update.add_argument("-e", "--expire", help="expiration time")
    p_update.add_argument("-s", "--passwd", help="password (overrides history lookup)")
    p_update.add_argument("-f", "--file", help="read paste from file")
    p_update.add_argument(
        "-x", "--clip", action="store_true", help="copy URL to clipboard"
    )
    add_encryption_arguments(p_update)
    p_update.add_argument(
        "-F",
        "--filename",
        help="override the filename stored with the paste "
        "(defaults to the basename of the source file, if any)",
    )
    p_update.set_defaults(func=cmd_update)

    p_get = sub.add_parser(
        "get",
        aliases=["g"],
        help="fetch a paste",
        parents=[common],
    )
    p_get.add_argument(
        "name",
        help="NAME[.EXT], or a URL of the paste such as https://shz.al/d/NAME#KEY, "
        "which also selects the endpoint and gives the key",
    )
    p_get.add_argument("-o", "--output", help="write to FILE instead of stdout")
    p_get.add_argument(
        "-u", "--url", action="store_true", help="hit /u/ for 302 URL redirect"
    )
    p_get.add_argument(
        "--meta", action="store_true", help="fetch /m/<name> metadata as pretty JSON"
    )
    p_get.add_argument(
        "-K",
        "--key",
        help="decryption key (overrides history lookup); only used if paste is encrypted",
    )
    p_get.add_argument(
        "--no-decrypt",
        action="store_true",
        help="do not decrypt encrypted pastes; write raw ciphertext",
    )
    p_get.add_argument(
        "--save",
        nargs="?",
        const=".",
        default=None,
        metavar="DIR",
        help="save under DIR using the server-provided filename "
        "(DIR defaults to current directory; falls back to the paste name "
        "if the server has no filename)",
    )
    p_get.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="with --save, overwrite an existing file without prompting; "
        "without --save, allow binary content to be written to a terminal",
    )
    p_get.set_defaults(func=cmd_get)

    p_del = sub.add_parser(
        "delete",
        aliases=["d"],
        help="delete a paste",
        parents=[common],
    )
    p_del.add_argument(
        "target",
        help="NAME[:PASSWD], or a URL of the paste such as its manage URL, "
        "which also selects the endpoint",
    )
    p_del.set_defaults(func=cmd_delete)

    p_list = sub.add_parser(
        "list",
        aliases=["l"],
        help="list pastes uploaded from here",
        description="List the pastes in the history file that are on the current "
        "endpoint and neither deleted nor expired, most recently touched first. "
        "Expiry is judged from the expiration time the server returned.",
        parents=[common],
    )
    p_list.add_argument(
        "-a", "--all", action="store_true", help="include deleted and expired pastes"
    )
    p_list.add_argument(
        "--all-endpoints", action="store_true", help="include pastes on other endpoints"
    )
    output = p_list.add_mutually_exclusive_group()
    output.add_argument(
        "--json", action="store_true", help="print one JSON object per paste"
    )
    output.add_argument("--names", action="store_true", help="print paste names only")
    p_list.set_defaults(func=cmd_list)

    p_hist = sub.add_parser(
        "history",
        help="maintain the history file",
        description=f"Maintain the history file '{history_path()}', where pb records "
        "the passwords and keys of uploaded pastes.",
        parents=[common],
    )
    hist_sub = p_hist.add_subparsers(
        dest="history_action", required=True, metavar="ACTION"
    )
    p_migrate = hist_sub.add_parser(
        "migrate",
        help="import the history file of older pb versions",
        description="Import the 'NAME:PASSWD[#KEY]' history file of older pb versions "
        f"(default: '{legacy_history_path()}'). That file does not record endpoints, "
        "so its pastes are imported as pastes on the current endpoint. Pastes already "
        "in the history are skipped, and the old file is left in place.",
        parents=[common],
    )
    p_migrate.add_argument("file", nargs="?", metavar="FILE", help="old history file")
    p_migrate.set_defaults(func=cmd_history_migrate)
    p_prune = hist_sub.add_parser(
        "prune",
        help="drop deleted and expired pastes",
        description="Remove the records of deleted and expired pastes, on all endpoints, "
        "from the history file.",
        parents=[common],
    )
    p_prune.set_defaults(func=cmd_history_prune)

    return parser


def main(argv: Optional[list] = None) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)
    # These flags use default=argparse.SUPPRESS so that placing them before
    # the action does not get clobbered by the subparser. Fill in fallbacks.
    args.verbose = getattr(args, "verbose", False)
    args.dry = getattr(args, "dry", False)
    base_url = getattr(args, "base_url", None)
    setup_logger(args.verbose)

    domain = (base_url or os.environ.get("PB_DOMAIN") or DEFAULT_DOMAIN).rstrip("/")
    args.func(args, domain)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Ensure any in-flight progress bar leaves the cursor on a fresh line.
        if sys.stderr.isatty():
            sys.stderr.write("\n")
            sys.stderr.flush()
        if logger.handlers:
            logger.warning("interrupted")
        sys.exit(130)
